{
  "name": "terralauncher",
  "version": "0.1.0",
  "description": "Launcher Minecraft Terranova",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "web": "vite",
    "build": "vite build",
    "start": "electron .",
    "secrets": "node scripts/write-build-secrets.js"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "@xmcl/task": "4.1.1",
    "adm-zip": "0.5.16",
    "framer-motion": "11.15.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "33.2.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "vite": "5.4.11",
    "wait-on": "8.0.1"
  }
}
